# Maintainer: Raihan <maularaihan-git>
pkgname=koppie-driver-manager
pkgver=1.0.0
pkgrel=4
pkgdesc="Automatic hardware detection and driver manager for Koppie Linux"
arch=('any')
license=('GPL')
depends=('python' 'tk' 'python-pillow')
optdepends=(
    'linux-lts-headers: Required for building DKMS kernel modules'
    'broadcom-wl-dkms: Broadcom Wi-Fi driver for MacBooks and select laptops'
)

package() {
    install -d "$pkgdir/usr/share/koppie/koppie-driver-manager"
    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/share/icons/hicolor/512x512/apps"
    install -d "$pkgdir/usr/share/pixmaps"

    # Copy script and libraries
    cp -r "$startdir/app/"* "$pkgdir/usr/share/koppie/koppie-driver-manager/"

    # Install logo icon
    install -m644 "$startdir/app/assets/koppie-logo.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/koppie-driver-manager.png"
    install -m644 "$startdir/app/assets/koppie-logo.png" "$pkgdir/usr/share/pixmaps/koppie-driver-manager.png"

    # Wrapper script in /usr/bin
    cat << 'EOF' > "$pkgdir/usr/bin/koppie-driver-manager"
#!/usr/bin/env bash
python3 /usr/share/koppie/koppie-driver-manager/koppie_driver_manager.py "$@"
EOF
    chmod +x "$pkgdir/usr/bin/koppie-driver-manager"

    # Desktop file
    cat << 'EOF' > "$pkgdir/usr/share/applications/koppie-driver-manager.desktop"
[Desktop Entry]
Name=Koppie Driver Manager
Comment=Detect hardware and manage drivers for Koppie Linux
Exec=koppie-driver-manager
Icon=koppie-driver-manager
Terminal=false
Type=Application
Categories=System;Settings;HardwareSettings;
StartupNotify=true
EOF
}
