# Maintainer: Raihan <maularaihan-git>
pkgname=koppie-driver-manager
pkgver=1.0.0
pkgrel=1
pkgdesc="Aplikasi Deteksi Hardware & Manajemen Driver Otomatis Koppie Linux"
arch=('any')
license=('GPL')
depends=('python' 'tk')
optdepends=(
    'linux-lts-headers: Diperlukan untuk kompilasi modul kernel dkms'
    'broadcom-wl-dkms: Driver Wi-Fi Broadcom untuk MacBook dan laptop tertentu'
)

package() {
    install -d "$pkgdir/usr/share/koppie/koppie-driver-manager"
    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/share/applications"

    # Copy script dan library
    cp -r "$startdir/app/"* "$pkgdir/usr/share/koppie/koppie-driver-manager/"

    # Wrapper script di /usr/bin
    cat << 'EOF' > "$pkgdir/usr/bin/koppie-driver-manager"
#!/usr/bin/env bash
python3 /usr/share/koppie/koppie-driver-manager/koppie_driver_manager.py "$@"
EOF
    chmod +x "$pkgdir/usr/bin/koppie-driver-manager"

    # Desktop file
    cat << 'EOF' > "$pkgdir/usr/share/applications/koppie-driver-manager.desktop"
[Desktop Entry]
Name=Koppie Driver Manager
Comment=Deteksi Hardware & Manajemen Driver Otomatis Koppie Linux
Exec=koppie-driver-manager
Icon=preferences-system
Terminal=false
Type=Application
Categories=System;Settings;HardwareSettings;
StartupNotify=true
EOF
}
